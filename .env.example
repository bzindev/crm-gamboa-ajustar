# Copie para .env.local e preencha. Nenhuma dessas chaves deve ter valor
# real commitado neste arquivo.

# --- Supabase ---------------------------------------------------------------
# URL e chave anônima: públicas por design, protegidas pela RLS de cada tabela.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: ignora RLS por completo. Só usada em rotas de servidor que
# fazem isso conscientemente (worker de fila, rotas de admin) e que filtram
# org_id manualmente. Nunca expor no cliente, nunca logar.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta Graph API) ------------------------------------
# App Secret do app no Meta for Developers. Usado para validar o HMAC
# SHA-256 do header X-Hub-Signature-256 em todo webhook recebido.
WHATSAPP_APP_SECRET=

# Token arbitrário que você escolhe e cadastra no painel da Meta ao
# configurar o webhook (GET de verificação, hub.verify_token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API usada nas chamadas (confirme a versão vigente antes
# de cada deploy — a Meta descontinua versões antigas periodicamente).
WHATSAPP_GRAPH_API_VERSION=v23.0

# Chave simétrica (32 bytes, base64) usada por lib/crypto/token-cipher.ts
# (AES-256-GCM, em Node) para criptografar channels.access_token_encrypted
# em repouso. Cifra em Node, não em pgcrypto: pgp_sym_encrypt exigiria
# mandar a chave como parâmetro de uma query SQL, arriscando vazar em log
# de statement do Postgres. Gere com:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Aplicação ---------------------------------------------------------------
# Domínio de produção. PREENCHER antes do deploy (usado em links de convite,
# callbacks, CORS). Em desenvolvimento local, deixe o valor de localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo compartilhado que os endpoints /api/cron/* exigem no header
# Authorization para aceitar a chamada do Vercel Cron (ou de um cron manual
# em outro provedor). Sem isso, qualquer um poderia disparar o worker.
CRON_SECRET=
